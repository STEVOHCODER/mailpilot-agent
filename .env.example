# MailPilot secrets. Copy this file to ".env" and fill in real values.

# --- Gmail API backend (recommended; works on proxy/HTTPS-only networks) ---
# Google Cloud Console -> create project -> enable Gmail API ->
# OAuth consent screen (External, add yourself as test user) ->
# Credentials -> Create OAuth client ID -> Desktop app -> copy both values
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- IMAP fallback (used when gmail_token.json is absent and backend=auto) ---
# Gmail: https://myaccount.google.com/apppasswords  (requires 2FA enabled)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop

# --- WhatsApp via Meta Cloud API (provider=meta in config.yaml) ---
# https://developers.facebook.com -> create app -> add "WhatsApp" product
# Use the access token from API Setup; for testing use the provided test number.
WHATSAPP_TOKEN=
# The phone number ID shown in the Meta dashboard (API Setup page)
# Also put this value in config.yaml under whatsapp.meta_phone_number_id

# --- OR WhatsApp via Twilio (provider=twilio in config.yaml) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional: AI summaries + smarter scoring via Gemini 2.5 Flash ---
# https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=

# --- Optional: alternative AI reviewer ---
OPENAI_API_KEY=
